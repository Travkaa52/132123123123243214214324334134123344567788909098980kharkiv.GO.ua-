rules_version = '2';

// Правила Firestore для Kharkiv GO.
// -----------------------------------------------------------------------
// Єдина колекція, яку використовує застосунок — pushSubscriptions:
// один документ на анонімного Firebase-користувача (id документа == uid),
// у ньому FCM-токен пристрою і список обраних маршрутів, по яких
// користувач хоче отримувати сповіщення про затримки.
//
// Модель безпеки: документ належить рівно одному uid і читати/писати його
// може лише власник токена автентифікації з тим самим uid (Anonymous Auth
// теж видає стабільний, перевірюваний токен — request.auth.uid підробити
// неможливо). Ніхто інший (включно з іншими анонімними користувачами) не
// може прочитати чи змінити чужий документ — токени пристроїв інших людей
// лишаються приватними. Пряме видалення документа з клієнта не дозволяємо:
// вимкнення сповіщень робиться оновленням полів (enabled=false, токен
// прибирається), а не delete, щоб не втратити історію/налаштування.
service cloud.firestore {
  match /databases/{database}/documents {
    match /pushSubscriptions/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Усе інше в проєкті — заборонено за замовчуванням.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
